{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  env: {
    MISE_TRUSTED_CONFIG_PATHS: "./"
  },
  extends: [
    'github>home-operations/renovate-presets#10.0.0',
    'github>home-operations/renovate-presets//apps/grafanaDashboards.json5#10.0.0',
    'github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.0',
    'github>home-operations/renovate-presets//apps/searxng.json5#10.0.0',
    'github>MaverickD650/home-operations//.renovate/labels.json5',
    'github>MaverickD650/home-operations//.renovate/overrides.json5',
    'github>MaverickD650/home-operations//.renovate/upgradeBlock.json5',
    ':timezone(Europe/London)',
  ],
  ignorePaths: [
    "**/resources/**",
  ],
}
